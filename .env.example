# Supabase project API URL from the project's Connect dialog. Use HTTPS, not a Postgres connection string.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only. Required for Brevo password-recovery links and DB-backed rate limits.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Brevo sender must be verified in the Brevo account.
BREVO_API_KEY=YOUR_BREVO_API_KEY
BREVO_SENDER_EMAIL=subhamv2003@gmail.com
BREVO_SENDER_NAME=Shuvia

# Must be a random 32+ character secret, server only.
AUTH_FLOW_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
NEXT_PUBLIC_SITE_URL=http://localhost:3000
